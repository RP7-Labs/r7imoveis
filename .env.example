# Supabase — encontre em: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave privilegiada — SOMENTE no servidor, nunca exponha no cliente.
# Reservada para operações que precisem ignorar RLS (uso restrito).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em metadata, sitemap e canonical)
NEXT_PUBLIC_SITE_URL=https://r7imoveissc.com.br

# WhatsApp comercial — fallback caso site_settings não esteja configurado.
# Formato: código do país + DDD + número, somente dígitos. Ex: 5547999998888
NEXT_PUBLIC_WHATSAPP_NUMBER=
